--- a/mlx/backend/metal/quantized.cpp
+++ b/mlx/backend/metal/quantized.cpp
@@ -298,6 +298,18 @@
 // affine qmv_wide only beats qmv on gen-15+; fp benefits on every gen.
+// GMBasic patch (2026-10-03): qmv_wide (M>=2) NON bit-identico al qmv -> sul batch rompe la
+// bit-parity di gpt-oss. Controllo via API (NO env): mlx::core::set_qmv_wide(v), v=-1 default(arch),
+// 0 off, 1 on. L'engine lo imposta dal registro opzioni (`qmv_wide`).
+int g_qmv_wide_opt = -1;
+void set_qmv_wide(int v) { g_qmv_wide_opt = v; }
+int get_qmv_wide() { return g_qmv_wide_opt; }
 inline bool use_qmv_wide(const std::string& mode, metal::Device& d) {
+  const int o = g_qmv_wide_opt;
+  if (o == 0) return false;
   return mode != "affine" || d.get_architecture_gen() >= 15;
 }
--- a/mlx/memory.h
+++ b/mlx/memory.h
@@
 MLX_API void dump_retained();
+MLX_API void set_qmv_wide(int v);
--- a/mlx/c/memory.cpp  (mlx-c)
+++ b/mlx/c/memory.cpp
@@
+extern "C" int mlx_set_qmv_wide(int v) {
+  try { mlx::core::set_qmv_wide(v); } catch (std::exception& e) { mlx_error(e.what()); return 1; }
+  return 0;
+}
--- a/mlx/c/memory.h  (mlx-c)
