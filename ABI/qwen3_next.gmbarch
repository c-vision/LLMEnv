{
  "arch": "qwen3_next",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "head_dim": "head_dim",
    "vocab": "vocab_size",
    "rope_theta": "rope_theta",
    "dense_inter": "intermediate_size",
    "experts": "num_experts",
    "top_k": "num_experts_per_tok",
    "moe_inter": "moe_intermediate_size"
  },
  "roles": [
    {
      "match": "input_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "post_attention_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "post_feedforward_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "pre_feedforward_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "attn_norm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "ffn_norm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "kv_a_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_kv_a_norm.weight"
    },
    {
      "match": "q_a_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_q_a_norm.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "gguf": "output.weight"
    },
    {
      "match": "embed_tokens",
      "role": "EMBEDDING",
      "gguf": "token_embd.weight"
    },
    {
      "match": "linear_attn",
      "role": "ATTN_LINEAR"
    },
    {
      "match": "mlp.gate.weight",
      "role": "ROUTER",
      "gguf": "blk.%d.ffn_gate_inp.weight"
    },
    {
      "match": "shared_expert.",
      "role": "SHARED_EXPERT"
    },
    {
      "match": "shared_expert_gate",
      "role": "ROUTER"
    },
    {
      "match": "switch_mlp",
      "role": "ROUTED_EXPERT",
      "gguf": "blk.%d.ffn_%s_exps.weight"
    },
    {
      "match": "k_norm",
      "role": "NORM",
      "gguf": "blk.%d.attn_k_norm.weight"
    },
    {
      "match": "k_proj",
      "role": "ATTN_KV",
      "gguf": "blk.%d.attn_k.weight"
    },
    {
      "match": "o_proj",
      "role": "ATTN_WO",
      "gguf": "blk.%d.attn_output.weight"
    },
    {
      "match": "q_norm",
      "role": "NORM",
      "gguf": "blk.%d.attn_q_norm.weight"
    },
    {
      "match": "q_proj",
      "role": "ATTN_Q",
      "gguf": "blk.%d.attn_q.weight"
    },
    {
      "match": "v_proj",
      "role": "ATTN_V",
      "gguf": "blk.%d.attn_v.weight"
    },
    {
      "match": "norm",
      "role": "NORM",
      "gguf": "output_norm.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "norm": {
      "type": "rmsnorm",
      "prim": "rmsnorm"
    },
    "attention": {
      "type": "gqa",
      "steps": [
        {
          "op": "q_norm",
          "prim": "rmsnorm"
        },
        {
          "op": "k_norm",
          "prim": "rmsnorm"
        },
        {
          "op": "rope",
          "prim": ""
        },
        {
          "op": "sdpa",
          "prim": ""
        }
      ]
    },
    "moe": {
      "experts": "cfg:experts",
      "top_k": "cfg:top_k",
      "steps": [
        {
          "op": "router_topk",
          "prim": ""
        },
        {
          "op": "experts",
          "prim": ""
        },
        {
          "op": "shared",
          "prim": ""
        }
      ]
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert",
    "f16": "f16"
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
