{
  "_comment": ".llmarch — PaddleOCR-VL (OCR vision-language). Decoder testuale llama-style (GGUF); il vision encoder sta nel mmproj.",
  "arch": "paddleocr_vl",
  "source": {
    "format": "gguf",
    "mmproj": "PaddleOCR-VL-1.6-GGUF-mmproj.gguf"
  },
  "roles": [
    {
      "match": "token_embd",
      "role": "EMBEDDING"
    },
    {
      "match": "output_norm",
      "role": "NORM"
    },
    {
      "match": "output.weight",
      "role": "OUTPUT"
    },
    {
      "match": "attn_q",
      "role": "ATTN_Q"
    },
    {
      "match": "attn_k",
      "role": "ATTN_KV"
    },
    {
      "match": "attn_v",
      "role": "ATTN_V"
    },
    {
      "match": "attn_output",
      "role": "ATTN_OUT"
    },
    {
      "match": "attn_norm",
      "role": "NORM"
    },
    {
      "match": "ffn_norm",
      "role": "NORM"
    },
    {
      "match": "ffn_gate",
      "role": "FFN_GATE"
    },
    {
      "match": "ffn_up",
      "role": "FFN_UP"
    },
    {
      "match": "ffn_down",
      "role": "FFN_DOWN"
    },
    {
      "match": "mmproj",
      "role": "VISION_ALIGNER"
    },
    {
      "match": "v.",
      "role": "VISION"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "bf16",
    "OUTPUT": "bf16"
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn",       "prim": "" }
      ]
    },
    "norm": {
      "type": "rmsnorm",
      "prim": "rmsnorm"
    },
    "attention": {
      "type": "gqa"
    },
    "vision": {
      "type": "vit",
      "present": true
    }
  },
  "config_map": {
    "n_layers": "block_count",
    "hidden": "embedding_length",
    "n_heads": "attention.head_count",
    "n_kv": "attention.head_count_kv",
    "head_dim": "attention.key_length",
    "vocab": "vocab_size"
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}