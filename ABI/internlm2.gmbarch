{
  "arch": "internlm2",
  "_comment": ".gmbarch — InternLM2: `attention.wqkv` FUSO interleaved + `wo`; FFN con tre matrici separate `w1`(gate)/`w3`(up)/`w2`(down); prefisso `model.`.",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "model.tok_embeddings",
      "role": "EMBEDDING",
      "hf": "model.tok_embeddings.weight"
    },
    {
      "match": "model.norm",
      "role": "FINAL_NORM",
      "hf": "model.norm.weight"
    },
    {
      "match": "output",
      "role": "OUTPUT",
      "hf": "output.weight"
    },
    {
      "match": "layers.%d.attention_norm",
      "role": "NORM",
      "hf": "model.layers.%d.attention_norm.weight"
    },
    {
      "match": "layers.%d.ffn_norm",
      "role": "NORM",
      "hf": "model.layers.%d.ffn_norm.weight"
    },
    {
      "match": "layers.%d.attention.wqkv",
      "role": "ATTN_QKV",
      "hf": "model.layers.%d.attention.wqkv.weight"
    },
    {
      "match": "layers.%d.attention.wo",
      "role": "ATTN_WO",
      "hf": "model.layers.%d.attention.wo.weight"
    },
    {
      "match": "layers.%d.feed_forward.w1",
      "role": "FFN",
      "hf": "model.layers.%d.feed_forward.w1.weight"
    },
    {
      "match": "layers.%d.feed_forward.w3",
      "role": "FFN",
      "hf": "model.layers.%d.feed_forward.w3.weight"
    },
    {
      "match": "layers.%d.feed_forward.w2",
      "role": "FFN",
      "hf": "model.layers.%d.feed_forward.w2.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "attention": {
      "type": "gqa"
    },
    "ffn": {
      "type": "swiglu"
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
