{
  "_comment": "Generato automaticamente da llmdesc_ensure_for_dir (modello mlx-community/stablelm-2-zephyr-1_6b-4bit). Base dedotta dai nomi dei tensori: si puo' rifinire a mano; il file esistente non viene mai sovrascritto.",
  "arch": "stablelm",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "rope_theta": "rope_theta",
    "dense_inter": "intermediate_size"
  },
  "roles": [
    { "match": "lm_head", "role": "OUTPUT" },
    { "match": "embed_tokens", "role": "EMBEDDING" },
    { "match": "norm", "role": "NORM" },
    { "match": "down_proj", "role": "FFN" },
    { "match": "gate_proj", "role": "FFN" },
    { "match": "up_proj", "role": "FFN" },
    { "match": "k_proj", "role": "ATTN_KV" },
    { "match": "o_proj", "role": "ATTN_WO" },
    { "match": "q_proj", "role": "ATTN_Q" },
    { "match": "v_proj", "role": "ATTN_V" }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": ["attn_v", "ffn_down"],
    "recipe_boost_fmt": "q6_k"
  },
  "structures": {
    "norm": { "type": "rmsnorm", "prim": "rmsnorm" },
    "attention": { "type": "gqa", "steps": [ {"op":"rope","prim":""}, {"op":"sdpa","prim":""} ] }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert",
    "f16": "f16"
  },
  "weight_source": {
    "mlx_affine": { "dtype": "U32", "codec": "mlx_affine", "scale_suffix": ".scales", "bias_suffix": ".biases" },
    "plain_f16": { "dtype": "F16", "codec": "plain", "fmt": 1 },
    "plain_bf16": { "dtype": "BF16", "codec": "plain", "fmt": 2 },
    "plain_f32": { "dtype": "F32", "codec": "plain", "fmt": 0 }
  },
  "quant_params": { "group": 32, "bits": 4 },
  "convert_target": { "default": { "codec": "mlx_affine", "p0": 32, "p1": 4 } }
}
