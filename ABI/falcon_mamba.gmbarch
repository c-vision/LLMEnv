{
  "_comment": ".gmbarch — Falcon-Mamba (SSM Mamba-1, prefisso `backbone.` come nel repo HF tiiuae/falcon-mamba). SSM_A = A_log, SSM_CONV = conv1d, SSM_IN/X/DT = in_proj/x_proj/dt_proj; out_proj resta OTHER (non c'e' un ruolo SSM_OUT).",
  "arch": "falcon_mamba",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "backbone.embeddings",
      "role": "EMBEDDING",
      "hf": "backbone.embeddings.weight"
    },
    {
      "match": "backbone.layers.%d.norm",
      "role": "NORM",
      "hf": "backbone.layers.%d.norm.weight"
    },
    {
      "match": "backbone.layers.%d.mixer.in_proj",
      "role": "SSM_IN",
      "hf": "backbone.layers.%d.mixer.in_proj.weight"
    },
    {
      "match": "backbone.layers.%d.mixer.conv1d",
      "role": "SSM_CONV",
      "hf": "backbone.layers.%d.mixer.conv1d.weight"
    },
    {
      "match": "backbone.layers.%d.mixer.x_proj",
      "role": "SSM_X",
      "hf": "backbone.layers.%d.mixer.x_proj.weight"
    },
    {
      "match": "backbone.layers.%d.mixer.dt_proj",
      "role": "SSM_DT",
      "hf": "backbone.layers.%d.mixer.dt_proj.weight"
    },
    {
      "match": "backbone.layers.%d.mixer.A_log",
      "role": "SSM_A",
      "hf": "backbone.layers.%d.mixer.A_log"
    },
    {
      "match": "backbone.layers.%d.mixer.out_proj",
      "role": "OTHER",
      "hf": "backbone.layers.%d.mixer.out_proj.weight"
    },
    {
      "match": "backbone.norm_f",
      "role": "FINAL_NORM",
      "hf": "backbone.norm_f.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "hf": "lm_head.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "ssm",
          "prim": ""
        }
      ]
    },
    "ssm": {
      "type": "mamba",
      "present": true
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
