{
  "arch": "llama",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "head_dim": "head_dim",
    "vocab": "vocab_size",
    "rope_theta": "rope_theta",
    "dense_inter": "intermediate_size"
  },
  "roles": [
    {
      "match": "embed_tokens",
      "role": "EMBEDDING",
      "gguf": "token_embd.weight",
      "hf": "model.embed_tokens.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "gguf": "output.weight",
      "hf": "lm_head.weight"
    },
    {
      "match": "input_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight",
      "hf": "model.layers.%d.input_layernorm.weight"
    },
    {
      "match": "post_attention_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight",
      "hf": "model.layers.%d.post_attention_layernorm.weight"
    },
    {
      "match": "down_proj",
      "role": "FFN",
      "gguf": "blk.%d.ffn_down.weight",
      "hf": "model.layers.%d.mlp.down_proj.weight"
    },
    {
      "match": "gate_proj",
      "role": "FFN",
      "gguf": "blk.%d.ffn_gate.weight",
      "hf": "model.layers.%d.mlp.gate_proj.weight"
    },
    {
      "match": "up_proj",
      "role": "FFN",
      "gguf": "blk.%d.ffn_up.weight",
      "hf": "model.layers.%d.mlp.up_proj.weight"
    },
    {
      "match": "q_proj",
      "role": "ATTN_Q",
      "gguf": "blk.%d.attn_q.weight",
      "hf": "model.layers.%d.self_attn.q_proj.weight"
    },
    {
      "match": "k_proj",
      "role": "ATTN_KV",
      "gguf": "blk.%d.attn_k.weight",
      "hf": "model.layers.%d.self_attn.k_proj.weight"
    },
    {
      "match": "v_proj",
      "role": "ATTN_V",
      "gguf": "blk.%d.attn_v.weight",
      "hf": "model.layers.%d.self_attn.v_proj.weight"
    },
    {
      "match": "o_proj",
      "role": "ATTN_WO",
      "gguf": "blk.%d.attn_output.weight",
      "hf": "model.layers.%d.self_attn.o_proj.weight"
    },
    {
      "match": "norm",
      "role": "NORM",
      "gguf": "output_norm.weight",
      "hf": "model.norm.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "structures": {
    "norm": {
      "type": "rmsnorm",
      "prim": "rmsnorm"
    },
    "attention": {
      "type": "gqa",
      "steps": [
        {
          "op": "rope",
          "prim": ""
        },
        {
          "op": "sdpa",
          "prim": ""
        }
      ]
    },
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert",
    "f16": "f16"
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
