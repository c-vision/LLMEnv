{
  "_comment": ".llmarch — Ernie 4.5 MoE (DA VALIDARE col config reale).",
  "arch": "ernie4_5",
  "source": {
    "format": "safetensors",
    "config": "config.json"
  },
  "roles": [
    {
      "match": "embed_tokens",
      "role": "EMBEDDING"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT"
    },
    {
      "match": "norm",
      "role": "NORM"
    },
    {
      "match": "self_attn.q_proj",
      "role": "ATTN_Q"
    },
    {
      "match": "self_attn.o_proj",
      "role": "ATTN_OUT"
    },
    {
      "match": "mlp.gate",
      "role": "ROUTER"
    },
    {
      "match": "mlp.experts",
      "role": "ROUTED_EXPERT"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn",       "prim": "" }
      ]
    },
    "norm": {
      "type": "rmsnorm"
    },
    "attention": {
      "type": "gqa"
    },
    "moe": {
      "expert_axis": 3
    }
  },
  "runtime": {
    "state": {
      "kind": "attention_kv"
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}