        },
        {
          "op": "router_topk",
          "prim": ""
        },
        {
          "op": "experts",
          "prim": ""
        },
        {
          "op": "shared",
          "prim": ""
        }
      ]
    },
    "head": {
      "type": "mhc_head",
      "steps": [
        {
          "op": "collapse",
          "prim": ""
        },
        {
          "op": "rmsnorm",
          "prim": ""
        },
        {
          "op": "lm_head",
          "prim": ""
        }
      ]
    },
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "mhc_pre_attn",
          "prim": ""
        },
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "mhc_post_attn",
          "prim": ""
        },
        {
          "op": "mhc_pre_ffn",
          "prim": ""
        },
        {
          "op": "moe",
          "prim": ""
        },
        {
          "op": "mhc_post_ffn",
          "prim": ""
        }
      ]
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "codecs": {
    "ggml": "ggml",
    "plain": "plain",
    "f16": "f16"
