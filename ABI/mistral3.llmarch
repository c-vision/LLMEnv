{
  "_comment": ".llmarch — Mistral3 (MULTIMODALE: vision encoder + projector + text decoder). Moduli con codec potenzialmente diversi.",
  "arch": "mistral3",
  "source": {
    "format": "safetensors",
    "config": "config.json"
  },
  "config_map": {
    "n_layers": "text_config.num_hidden_layers",
    "hidden": "text_config.hidden_size",
    "n_heads": "text_config.num_attention_heads",
    "n_kv": "text_config.num_key_value_heads",
    "head_dim": "text_config.head_dim",
    "vocab": "text_config.vocab_size"
  },
  "roles": [
    {
      "match": "language_model.model.embed_tokens",
      "role": "EMBEDDING"
    },
    {
      "match": "language_model.lm_head",
      "role": "OUTPUT"
    },
    {
      "match": "language_model.model.norm",
      "role": "FINAL_NORM"
    },
    {
      "match": "input_layernorm",
      "role": "NORM"
    },
    {
      "match": "post_attention_layernorm",
      "role": "NORM"
    },
    {
      "match": "self_attn.q_proj",
      "role": "ATTN_Q"
    },
    {
      "match": "self_attn.k_proj",
      "role": "ATTN_KV"
    },
    {
      "match": "self_attn.v_proj",
      "role": "ATTN_V"
    },
    {
      "match": "self_attn.o_proj",
      "role": "ATTN_OUT"
    },
    {
      "match": "mlp.gate_proj",
      "role": "FFN_GATE"
    },
    {
      "match": "mlp.up_proj",
      "role": "FFN_UP"
    },
    {
      "match": "mlp.down_proj",
      "role": "FFN_DOWN"
    },
    {
      "match": "vision_tower",
      "role": "VISION"
    },
    {
      "match": "multi_modal_projector",
      "role": "VISION_ALIGNER"
    },
    {
      "match": "patch_embed",
      "role": "VISION"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "VISION": "f16",
    "OUTPUT": "q6_k"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn",       "prim": "" }
      ]
    },
    "norm": {
      "type": "rmsnorm",
      "prim": "rmsnorm"
    },
    "attention": {
      "type": "gqa"
    },
    "vision": {
      "type": "vit",
      "present": true
    }
  },
  "runtime": {
    "multimodal": {
      "vision": "vit",
      "aligner": true
    },
    "tokenizer": {
      "kind": "bpe"
    },
    "kv": {
      "dtype": "bf16"
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "quant_params": {
    "group": 32,
    "bits": 8
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 8
    }
  }
}