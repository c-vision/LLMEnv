{
  "arch": "qwen",
  "_comment": ".gmbarch — Qwen-1 (Qwen-7B/14B, 2023): nomenclatura GPT-like `transformer.h.N.*`, attenzione `c_attn` FUSA, MLP con `w1` FUSO (gate+up in una sola matrice) e `w2`. Distinto da qwen2.gmbarch (model.layers + q/k/v separati).",
  "tokenizer_pre": "qwen2",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "transformer.wte",
      "role": "EMBEDDING",
      "hf": "transformer.wte.weight"
    },
    {
      "match": "transformer.ln_f",
      "role": "FINAL_NORM",
      "hf": "transformer.ln_f.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "hf": "lm_head.weight"
    },
    {
      "match": "h.%d.ln_1",
      "role": "NORM",
      "hf": "transformer.h.%d.ln_1.weight"
    },
    {
      "match": "h.%d.ln_2",
      "role": "NORM",
      "hf": "transformer.h.%d.ln_2.weight"
    },
    {
      "match": "h.%d.attn.c_attn",
      "role": "ATTN_QKV",
      "hf": "transformer.h.%d.attn.c_attn.weight"
    },
    {
      "match": "h.%d.attn.c_proj",
      "role": "ATTN_WO",
      "hf": "transformer.h.%d.attn.c_proj.weight"
    },
    {
      "match": "h.%d.mlp.w1",
      "role": "FFN",
      "hf": "transformer.h.%d.mlp.w1.weight"
    },
    {
      "match": "h.%d.mlp.w2",
      "role": "FFN",
      "hf": "transformer.h.%d.mlp.w2.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "attention": {
      "type": "mha"
    },
    "ffn": {
      "type": "swiglu"
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
