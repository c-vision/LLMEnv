{
  "_comment": ".gmbarch — GPT-NeoX / Pythia (rotary, query_key_value fuso, MLP dense_h_to_4h). Nomi HF standard di transformers (`modeling_gpt_neox.py`).",
  "arch": "gpt_neox",
  "tokenizer_pre": "gpt2",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "embed_in",
      "role": "EMBEDDING",
      "hf": "embed_in.weight",
      "gguf": "token_embd.weight"
    },
    {
      "match": "layers.%d.input_layernorm",
      "role": "NORM",
      "hf": "layers.%d.input_layernorm.weight",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "layers.%d.post_attention_layernorm",
      "role": "NORM",
      "hf": "layers.%d.post_attention_layernorm.weight",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "layers.%d.attention.query_key_value",
      "role": "ATTN_QKV",
      "hf": "layers.%d.attention.query_key_value.weight",
      "gguf": "blk.%d.attn_qkv.weight"
    },
    {
      "match": "layers.%d.attention.dense",
      "role": "ATTN_WO",
      "hf": "layers.%d.attention.dense.weight",
      "gguf": "blk.%d.attn_output.weight"
    },
    {
      "match": "layers.%d.mlp.dense_h_to_4h",
      "role": "FFN",
      "hf": "layers.%d.mlp.dense_h_to_4h.weight",
      "gguf": "blk.%d.ffn_up.weight"
    },
    {
      "match": "layers.%d.mlp.dense_4h_to_h",
      "role": "FFN",
      "hf": "layers.%d.mlp.dense_4h_to_h.weight",
      "gguf": "blk.%d.ffn_down.weight"
    },
    {
      "match": "final_layer_norm",
      "role": "FINAL_NORM",
      "hf": "final_layer_norm.weight",
      "gguf": "output_norm.weight"
    },
    {
      "match": "embed_out",
      "role": "OUTPUT",
      "hf": "embed_out.weight",
      "gguf": "output.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "norm": {
      "type": "layernorm"
    },
    "attention": {
      "type": "mha",
      "steps": [
        {
          "op": "rope",
          "prim": ""
        },
        {
          "op": "sdpa",
          "prim": ""
        }
      ]
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
