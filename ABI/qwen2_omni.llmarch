{
  "_comment": ".llmarch — Qwen2.5-Omni (multimodale: testo Qwen2 + vision + audio). Il testo e' qwen2 (con bias attn); vision/audio nel mmproj.",
  "arch": "qwen2_omni",
  "source": {
    "format": "gguf",
    "mmproj": "mmproj-Qwen2.5-Omni-3B-Q8_0.gguf"
  },
  "roles": [
    { "match": "lm_head",                   "role": "OUTPUT",        "gguf": "output.weight" },
    { "match": "embed_tokens",              "role": "EMBEDDING",     "gguf": "token_embd.weight" },
    { "match": "input_layernorm",           "role": "NORM",          "gguf": "blk.%d.attn_norm.weight" },
    { "match": "post_attention_layernorm",  "role": "NORM",          "gguf": "blk.%d.ffn_norm.weight" },
    { "match": "norm",                      "role": "NORM",          "gguf": "output_norm.weight" },
    { "match": "q_proj",                    "role": "ATTN_Q",        "gguf": "blk.%d.attn_q.weight" },
    { "match": "k_proj",                    "role": "ATTN_KV",       "gguf": "blk.%d.attn_k.weight" },
    { "match": "v_proj",                    "role": "ATTN_V",        "gguf": "blk.%d.attn_v.weight" },
    { "match": "o_proj",                    "role": "ATTN_WO",       "gguf": "blk.%d.attn_output.weight" },
    { "match": "gate_proj",                 "role": "FFN_GATE",      "gguf": "blk.%d.ffn_gate.weight" },
    { "match": "up_proj",                   "role": "FFN_UP",        "gguf": "blk.%d.ffn_up.weight" },
    { "match": "down_proj",                 "role": "FFN_DOWN",      "gguf": "blk.%d.ffn_down.weight" },
    { "match": "mmproj",                    "role": "VISION_ALIGNER" },
    { "match": "v.blk",                     "role": "VISION" },
    { "match": "a.blk",                     "role": "AUDIO" }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "q4_k",
    "OUTPUT": "q6_k"
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn",       "prim": "" }
      ]
    },
    "norm": {
      "type": "rmsnorm",
      "prim": "rmsnorm"
    },
    "attention": {
      "type": "gqa"
    },
    "vision": {
      "type": "vit",
      "present": true
    },
    "audio": {
      "type": "whisper_style",
      "present": true
    }
  },
  "config_map": {
    "n_layers": "block_count",
    "hidden": "embedding_length",
    "n_heads": "attention.head_count",
    "n_kv": "attention.head_count_kv",
    "vocab": "vocab_size"
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}