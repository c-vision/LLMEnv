{
  "arch": "hunyuan_v1_dense",
  "_comment": ".gmbarch — Hunyuan v1 DENSE: GQA con bias + qk-norm (`query_layernorm`/`key_layernorm`) + SwiGLU. Distinto da hunyuan.gmbarch (MoE).",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "model.embed_tokens",
      "role": "EMBEDDING",
      "hf": "model.embed_tokens.weight"
    },
    {
      "match": "model.norm",
      "role": "FINAL_NORM",
      "hf": "model.norm.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "hf": "lm_head.weight"
    },
    {
      "match": "layers.%d.input_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.input_layernorm.weight"
    },
    {
      "match": "layers.%d.post_attention_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.post_attention_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.query_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.self_attn.query_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.key_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.self_attn.key_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.q_proj",
      "role": "ATTN_Q",
      "hf": "model.layers.%d.self_attn.q_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.k_proj",
      "role": "ATTN_KV",
      "hf": "model.layers.%d.self_attn.k_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.v_proj",
      "role": "ATTN_V",
      "hf": "model.layers.%d.self_attn.v_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.o_proj",
      "role": "ATTN_WO",
      "hf": "model.layers.%d.self_attn.o_proj.weight"
    },
    {
      "match": "layers.%d.mlp.gate_proj",
      "role": "FFN",
      "hf": "model.layers.%d.mlp.gate_proj.weight"
    },
    {
      "match": "layers.%d.mlp.up_proj",
      "role": "FFN",
      "hf": "model.layers.%d.mlp.up_proj.weight"
    },
    {
      "match": "layers.%d.mlp.down_proj",
      "role": "FFN",
      "hf": "model.layers.%d.mlp.down_proj.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "attention": {
      "type": "gqa"
    },
    "ffn": {
      "type": "swiglu"
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
