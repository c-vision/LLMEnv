{
  "_comment": ".gmbarch — DeepSeek-V3 (MLA + MoE). Nomi dei tensori = stessa convenzione di deepseek_v2 (self_attn.q_a/q_b/kv_a/kv_b, mlp.experts.N.*, mlp.shared_experts.*). Derivato da deepseek_v2.gmbarch; la differenza e' nella config, non nei nomi.",
  "arch": "deepseek_v3",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "model.embed_tokens",
      "role": "EMBEDDING",
      "hf": "model.embed_tokens.weight"
    },
    {
      "match": "model.norm",
      "role": "FINAL_NORM",
      "hf": "model.norm.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "hf": "lm_head.weight"
    },
    {
      "match": "layers.%d.input_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.input_layernorm.weight"
    },
    {
      "match": "layers.%d.post_attention_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.post_attention_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.q_a_proj",
      "role": "ATTN_Q_A",
      "hf": "model.layers.%d.self_attn.q_a_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.q_a_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.self_attn.q_a_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.q_b_proj",
      "role": "ATTN_Q_B",
      "hf": "model.layers.%d.self_attn.q_b_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.kv_a_proj_with_mqa",
      "role": "ATTN_KV",
      "hf": "model.layers.%d.self_attn.kv_a_proj_with_mqa.weight"
    },
    {
      "match": "layers.%d.self_attn.kv_a_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.self_attn.kv_a_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.kv_b_proj",
      "role": "ATTN_KV_B",
      "hf": "model.layers.%d.self_attn.kv_b_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.o_proj",
      "role": "ATTN_WO",
      "hf": "model.layers.%d.self_attn.o_proj.weight"
    },
    {
      "match": "layers.%d.mlp.gate",
      "role": "ROUTER",
      "hf": "model.layers.%d.mlp.gate.weight"
    },
    {
      "match": "layers.%d.mlp.shared_experts",
      "role": "SHARED_EXPERT",
      "hf": "model.layers.%d.mlp.shared_experts.%s_proj.weight"
    },
    {
      "match": "layers.%d.mlp.experts",
      "role": "ROUTED_EXPERT",
      "hf": "model.layers.%d.mlp.experts.%d.%s_proj.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "moe",
          "prim": ""
        }
      ]
    },
    "attention": {
      "type": "mla"
    },
    "moe": {
      "type": "topk",
      "present": true
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
