{
  "_comment": ".gmbarch — OLMo2 Transformer (dense GQA + q/k-norm flat + POST-norm, full attention).",
  "arch": "olmo2",
  "source": {
    "format": "safetensors",
    "config": "config.json"
  },
  "roles": [
    {
      "match": "input_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "post_attention_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "post_feedforward_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "pre_feedforward_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "attn_norm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "ffn_norm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "kv_a_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_kv_a_norm.weight"
    },
    {
      "match": "q_a_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_q_a_norm.weight"
    },
    {
      "match": "embed_tokens",
      "role": "EMBEDDING",
      "gguf": "token_embd.weight",
      "hf": "model.embed_tokens.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "gguf": "output.weight",
      "hf": "lm_head.weight"
    },
    {
      "match": "self_attn.q_proj",
      "role": "ATTN_Q",
      "gguf": "blk.%d.attn_q.weight",
      "hf": "model.layers.%d.self_attn.q_proj.weight"
    },
    {
      "match": "self_attn.k_proj",
      "role": "ATTN_KV",
      "gguf": "blk.%d.attn_k.weight",
      "hf": "model.layers.%d.self_attn.k_proj.weight"
    },
    {
      "match": "self_attn.v_proj",
      "role": "ATTN_V",
      "gguf": "blk.%d.attn_v.weight",
      "hf": "model.layers.%d.self_attn.v_proj.weight"
    },
    {
      "match": "self_attn.o_proj",
      "role": "ATTN_OUT",
      "gguf": "blk.%d.attn_output.weight",
      "hf": "model.layers.%d.self_attn.o_proj.weight"
    },
    {
      "match": "mlp.gate_proj",
      "role": "FFN_GATE",
      "gguf": "blk.%d.ffn_gate.weight",
      "hf": "model.layers.%d.mlp.gate_proj.weight"
    },
    {
      "match": "mlp.up_proj",
      "role": "FFN_UP",
      "gguf": "blk.%d.ffn_up.weight",
      "hf": "model.layers.%d.mlp.up_proj.weight"
    },
    {
      "match": "mlp.down_proj",
      "role": "FFN_DOWN",
      "gguf": "blk.%d.ffn_down.weight",
      "hf": "model.layers.%d.mlp.down_proj.weight"
    },
    {
      "match": "norm",
      "role": "NORM",
      "gguf": "output_norm.weight",
      "hf": "model.norm.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "norm": {
      "type": "rmsnorm"
    },
    "attention": {
      "type": "gqa"
    }
  },
  "runtime": {
    "state": {
      "kind": "attention_kv"
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
