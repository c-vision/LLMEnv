{
  "_comment": ".llmarch — GLM-5 MoE + DSA (Deep Sparse Attention). DIVERSO da glm4_moe.",
  "arch": "glm_moe_dsa",
  "source": {
    "format": "safetensors",
    "config": "config.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "head_dim": "head_dim",
    "experts": "n_routed_experts",
    "top_k": "num_experts_per_tok",
    "inter": "intermediate_size",
    "vocab": "vocab_size"
  },
  "roles": [
    {
      "match": "embed_tokens",
      "role": "EMBEDDING"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT"
    },
    {
      "match": "model.norm",
      "role": "FINAL_NORM"
    },
    {
      "match": "input_layernorm",
      "role": "NORM"
    },
    {
      "match": "post_attention_layernorm",
      "role": "NORM"
    },
    {
      "match": "q_norm",
      "role": "NORM"
    },
    {
      "match": "k_norm",
      "role": "NORM"
    },
    {
      "match": "self_attn.q_proj",
      "role": "ATTN_Q"
    },
    {
      "match": "self_attn.k_proj",
      "role": "ATTN_KV"
    },
    {
      "match": "self_attn.v_proj",
      "role": "ATTN_V"
    },
    {
      "match": "self_attn.o_proj",
      "role": "ATTN_OUT"
    },
    {
      "match": "dsa",
      "role": "DSA"
    },
    {
      "match": "indexer",
      "role": "ATTN_INDEXER"
    },
    {
      "match": "mlp.gate.weight",
      "role": "ROUTER"
    },
    {
      "match": "mlp.experts",
      "role": "ROUTED_EXPERT"
    },
    {
      "match": "mlp.shared",
      "role": "SHARED_EXPERT"
    },
    {
      "match": "mlp.",
      "role": "FFN"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "ROUTED_EXPERT": "iq2_xxs",
    "SHARED_EXPERT": "q4_k"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn",       "prim": "" }
      ]
    },
    "norm": {
      "type": "rmsnorm",
      "prim": "rmsnorm"
    },
    "attention": {
      "type": "gqa"
    },
    "dsa": {
      "type": "dsa",
      "present": true
    },
    "moe": {
      "expert_axis": 3,
      "experts": "cfg:experts",
      "top_k": "cfg:top_k"
    }
  },
  "runtime": {
    "state": "attention_kv",
    "kv": {
      "dtype": "bf16"
    },
    "dsa": true
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "quant_params": {
    "group": 32,
    "bits": 8
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 8
    }
  }
}