{
  "_comment": ".gmbarch — Qwen3-ASR (speech-to-text multimodale: audio tower + decoder Qwen3 testo). Dominio ASR, NON LLM puro: il decoder ha lm_head TIED (nessun tensore output nel checkpoint). Descrizione derivata dai nomi reali letti da LLMEngine/asr (gmb_asr_model.c) sul checkpoint Qwen3-ASR-0.6B/1.7B.",
  "arch": "qwen3_asr",
  "tokenizer_pre": "qwen2",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "thinker_config.text_config.num_hidden_layers",
    "hidden": "thinker_config.text_config.hidden_size",
    "n_heads": "thinker_config.text_config.num_attention_heads",
    "n_kv": "thinker_config.text_config.num_key_value_heads",
    "vocab": "thinker_config.text_config.vocab_size",
    "dense_inter": "thinker_config.text_config.intermediate_size",
    "rope_theta": "thinker_config.text_config.rope_theta"
  },
  "roles": [
    { "match": "thinker.model.embed_tokens", "role": "EMBEDDING", "hf": "thinker.model.embed_tokens.weight" },
    { "match": "thinker.model.norm", "role": "NORM", "hf": "thinker.model.norm.weight" },

    { "match": "thinker.model.layers.%d.self_attn.q_proj", "role": "ATTN_Q",  "hf": "thinker.model.layers.%d.self_attn.q_proj.weight" },
    { "match": "thinker.model.layers.%d.self_attn.k_proj", "role": "ATTN_KV", "hf": "thinker.model.layers.%d.self_attn.k_proj.weight" },
    { "match": "thinker.model.layers.%d.self_attn.v_proj", "role": "ATTN_V",  "hf": "thinker.model.layers.%d.self_attn.v_proj.weight" },
    { "match": "thinker.model.layers.%d.self_attn.o_proj", "role": "ATTN_WO", "hf": "thinker.model.layers.%d.self_attn.o_proj.weight" },
    { "match": "thinker.model.layers.%d.self_attn.q_norm", "role": "NORM",    "hf": "thinker.model.layers.%d.self_attn.q_norm.weight" },
    { "match": "thinker.model.layers.%d.self_attn.k_norm", "role": "NORM",    "hf": "thinker.model.layers.%d.self_attn.k_norm.weight" },
    { "match": "thinker.model.layers.%d.input_layernorm",  "role": "NORM",    "hf": "thinker.model.layers.%d.input_layernorm.weight" },
    { "match": "thinker.model.layers.%d.post_attention_layernorm", "role": "NORM", "hf": "thinker.model.layers.%d.post_attention_layernorm.weight" },
    { "match": "thinker.model.layers.%d.mlp.gate_proj", "role": "FFN", "hf": "thinker.model.layers.%d.mlp.gate_proj.weight" },
    { "match": "thinker.model.layers.%d.mlp.up_proj",   "role": "FFN", "hf": "thinker.model.layers.%d.mlp.up_proj.weight" },
    { "match": "thinker.model.layers.%d.mlp.down_proj", "role": "FFN", "hf": "thinker.model.layers.%d.mlp.down_proj.weight" },

    { "match": "thinker.audio_tower.conv2d1",   "role": "AUDIO_CONV_STEM", "hf": "thinker.audio_tower.conv2d1.weight" },
    { "match": "thinker.audio_tower.conv2d2",   "role": "AUDIO_CONV_STEM", "hf": "thinker.audio_tower.conv2d2.weight" },
    { "match": "thinker.audio_tower.conv2d3",   "role": "AUDIO_CONV_STEM", "hf": "thinker.audio_tower.conv2d3.weight" },
    { "match": "thinker.audio_tower.conv_out",  "role": "AUDIO_CONV_OUT",  "hf": "thinker.audio_tower.conv_out.weight" },
    { "match": "thinker.audio_tower.ln_post",   "role": "NORM",            "hf": "thinker.audio_tower.ln_post.weight" },
    { "match": "thinker.audio_tower.proj1",     "role": "AUDIO_PROJ",      "hf": "thinker.audio_tower.proj1.weight" },
    { "match": "thinker.audio_tower.proj2",     "role": "AUDIO_PROJ",      "hf": "thinker.audio_tower.proj2.weight" },
    { "match": "thinker.audio_tower.layers.%d.self_attn.q_proj",   "role": "ATTN_Q",  "hf": "thinker.audio_tower.layers.%d.self_attn.q_proj.weight" },
    { "match": "thinker.audio_tower.layers.%d.self_attn.k_proj",   "role": "ATTN_KV", "hf": "thinker.audio_tower.layers.%d.self_attn.k_proj.weight" },
    { "match": "thinker.audio_tower.layers.%d.self_attn.v_proj",   "role": "ATTN_V",  "hf": "thinker.audio_tower.layers.%d.self_attn.v_proj.weight" },
    { "match": "thinker.audio_tower.layers.%d.self_attn.out_proj", "role": "ATTN_WO", "hf": "thinker.audio_tower.layers.%d.self_attn.out_proj.weight" },
    { "match": "thinker.audio_tower.layers.%d.self_attn_layer_norm", "role": "NORM",  "hf": "thinker.audio_tower.layers.%d.self_attn_layer_norm.weight" },
    { "match": "thinker.audio_tower.layers.%d.final_layer_norm",     "role": "NORM",  "hf": "thinker.audio_tower.layers.%d.final_layer_norm.weight" },
    { "match": "thinker.audio_tower.layers.%d.fc1", "role": "FFN", "hf": "thinker.audio_tower.layers.%d.fc1.weight" },
    { "match": "thinker.audio_tower.layers.%d.fc2", "role": "FFN", "hf": "thinker.audio_tower.layers.%d.fc2.weight" }
  ],
  "quant": {
    "NORM": "f32",
    "AUDIO_CONV_STEM": "f32",
    "AUDIO_CONV_OUT": "f32",
    "AUDIO_PROJ": "f32",
    "EMBEDDING": "f16"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn", "prim": "" }
      ]
    },
    "norm": { "type": "rmsnorm", "prim": "rmsnorm" },
    "attention": { "type": "gqa" },
    "encoder": {
      "type": "conv_augmented",
      "present": true,
      "_comment": "audio tower: conv stem (3 layer, stride 2, down x8) + transformer bidirezionale a finestre + projection"
    },
    "asr": {
      "type": "audio_text",
      "present": true,
      "_comment": "audio in ingresso -> embedding iniettate -> decoder causale (lm_head TIED a embed_tokens)"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "plain",
      "p0": 0,
      "p1": 0
    }
  }
}
