{
  "_comment": ".gmbarch — Qwen2-MoE (Qwen1.5-MoE-A2.7B / Qwen2-57B-A14B). Attenzione = Qwen2 (q/k/v con BIAS, GQA); esperti = tensori separati `mlp.experts.N.{gate,up,down}_proj` (non fusi come in qwen3_moe).",
  "arch": "qwen2_moe",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "model.embed_tokens",
      "role": "EMBEDDING",
      "hf": "model.embed_tokens.weight"
    },
    {
      "match": "model.norm",
      "role": "FINAL_NORM",
      "hf": "model.norm.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "hf": "lm_head.weight"
    },
    {
      "match": "layers.%d.input_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.input_layernorm.weight"
    },
    {
      "match": "layers.%d.post_attention_layernorm",
      "role": "NORM",
      "hf": "model.layers.%d.post_attention_layernorm.weight"
    },
    {
      "match": "layers.%d.self_attn.q_proj",
      "role": "ATTN_Q",
      "hf": "model.layers.%d.self_attn.q_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.k_proj",
      "role": "ATTN_KV",
      "hf": "model.layers.%d.self_attn.k_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.v_proj",
      "role": "ATTN_V",
      "hf": "model.layers.%d.self_attn.v_proj.weight"
    },
    {
      "match": "layers.%d.self_attn.o_proj",
      "role": "ATTN_WO",
      "hf": "model.layers.%d.self_attn.o_proj.weight"
    },
    {
      "match": "layers.%d.mlp.gate",
      "role": "ROUTER",
      "hf": "model.layers.%d.mlp.gate.weight"
    },
    {
      "match": "layers.%d.mlp.shared_expert",
      "role": "SHARED_EXPERT",
      "hf": "model.layers.%d.mlp.shared_expert.%s_proj.weight"
    },
    {
      "match": "layers.%d.mlp.experts",
      "role": "ROUTED_EXPERT",
      "hf": "model.layers.%d.mlp.experts.%d.%s_proj.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "moe",
          "prim": ""
        }
      ]
    },
    "attention": {
      "type": "gqa",
      "steps": [
        {
          "op": "rope",
          "prim": ""
        },
        {
          "op": "sdpa",
          "prim": ""
        }
      ]
    },
    "moe": {
      "type": "topk",
      "present": true
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
