{
  "_comment": "Generato automaticamente da llmdesc_ensure_for_dir (modello mlx-community/Mixtral-8x22B-4bit). Base dedotta dai nomi dei tensori: si puo' rifinire a mano; il file esistente non viene mai sovrascritto.",
  "arch": "mixtral",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "rope_theta": "rope_theta",
    "dense_inter": "intermediate_size",
    "top_k": "num_experts_per_tok"
  },
  "roles": [
    { "match": "lm_head", "role": "OUTPUT" },
    { "match": "embed_tokens", "role": "EMBEDDING" },
    { "match": "experts.", "role": "ROUTED_EXPERT" },
    { "match": "block_sparse_moe.gate", "role": "ROUTER" },
    { "match": "norm", "role": "NORM" },
    { "match": "k_proj", "role": "ATTN_KV" },
    { "match": "o_proj", "role": "ATTN_WO" },
    { "match": "q_proj", "role": "ATTN_Q" },
    { "match": "v_proj", "role": "ATTN_V" }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": ["attn_v", "ffn_down"],
    "recipe_boost_fmt": "q6_k"
  },
  "structures": {
    "norm": { "type": "rmsnorm", "prim": "rmsnorm" },
    "attention": { "type": "gqa", "steps": [ {"op":"rope","prim":""}, {"op":"sdpa","prim":""} ] },
    "moe": { "experts": "cfg:experts", "top_k": "cfg:top_k", "steps": [ {"op":"router_topk","prim":""}, {"op":"experts","prim":""}, {"op":"shared","prim":""} ] }
  }
}
