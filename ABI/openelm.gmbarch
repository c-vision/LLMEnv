{
  "arch": "openelm",
  "_comment": ".gmbarch — Apple OpenELM: `transformer.layers.N.attn.qkv_proj` FUSO + `out_proj`, FFN con `ffn.fuse_proj` (gate+up FUSO) + `ffn.proj`, heads PER-LAYER (config `head_dim`/`num_query_heads` per layer). Da llm_mlx_model_lifecycle.c: openelm_attention_block + openelm_ffn_block.",
  "tokenizer_pre": "llama",
  "source": {
    "format": "safetensors",
    "config": "config.json",
    "index": "model.safetensors.index.json"
  },
  "config_map": {
    "n_layers": "num_hidden_layers",
    "hidden": "hidden_size",
    "n_heads": "num_attention_heads",
    "n_kv": "num_key_value_heads",
    "vocab": "vocab_size",
    "dense_inter": "intermediate_size",
    "rope_theta": "rope_theta"
  },
  "roles": [
    {
      "match": "transformer.embeddings",
      "role": "EMBEDDING",
      "hf": "transformer.embeddings.weight"
    },
    {
      "match": "transformer.norm",
      "role": "FINAL_NORM",
      "hf": "transformer.norm.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "hf": "lm_head.weight"
    },
    {
      "match": "transformer.layers.%d.attn_norm",
      "role": "NORM",
      "hf": "transformer.layers.%d.attn_norm.weight"
    },
    {
      "match": "transformer.layers.%d.ffn_norm",
      "role": "NORM",
      "hf": "transformer.layers.%d.ffn_norm.weight"
    },
    {
      "match": "transformer.layers.%d.attn.qkv_proj",
      "role": "ATTN_QKV",
      "hf": "transformer.layers.%d.attn.qkv_proj.weight"
    },
    {
      "match": "transformer.layers.%d.attn.out_proj",
      "role": "ATTN_WO",
      "hf": "transformer.layers.%d.attn.out_proj.weight"
    },
    {
      "match": "transformer.layers.%d.ffn.fuse_proj",
      "role": "FFN",
      "hf": "transformer.layers.%d.ffn.fuse_proj.weight"
    },
    {
      "match": "transformer.layers.%d.ffn.proj",
      "role": "FFN",
      "hf": "transformer.layers.%d.ffn.proj.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16",
    "OUTPUT": "q6_k",
    "recipe": "_M",
    "recipe_boost": [
      "attn_v",
      "ffn_down"
    ],
    "recipe_boost_fmt": "q6_k"
  },
  "codecs": {
    "plain": "plain",
    "mlx_affine": "mlx_affine"
  },
  "weight_source": {
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    },
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    }
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "attention": {
      "type": "gqa"
    },
    "ffn": {
      "type": "swiglu"
    },
    "norm": {
      "type": "rmsnorm"
    }
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
