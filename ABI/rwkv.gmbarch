{
  "_comment": ".gmbarch — RWKV (RNN/linear attention) (DA VALIDARE col config reale).",
  "arch": "rwkv",
  "source": {
    "format": "safetensors",
    "config": "config.json"
  },
  "roles": [
    {
      "match": "embeddings",
      "role": "EMBEDDING"
    },
    {
      "match": "head",
      "role": "OUTPUT"
    },
    {
      "match": "ln_out",
      "role": "FINAL_NORM"
    },
    {
      "match": "att.receptance",
      "role": "RWKV_R"
    },
    {
      "match": "att.key",
      "role": "RWKV_K"
    },
    {
      "match": "att.value",
      "role": "RWKV_V"
    },
    {
      "match": "att.output",
      "role": "RWKV_O"
    },
    {
      "match": "time_mix",
      "role": "RWKV_MIX"
    },
    {
      "match": "ln",
      "role": "NORM"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        { "op": "attention", "prim": "" },
        { "op": "ffn",       "prim": "" }
      ]
    },
    "norm": {
      "type": "layernorm"
    },
    "state": {
      "type": "rwkv"
    }
  },
  "runtime": {
    "state": {
      "kind": "recurrent"
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}