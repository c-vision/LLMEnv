{
  "_comment": ".gmbarch — Griffin recurrent (DA VALIDARE col config reale).",
  "arch": "recurrent_gemma",
  "source": {
    "format": "safetensors",
    "config": "config.json"
  },
  "roles": [
    {
      "match": "input_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "post_attention_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "post_feedforward_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "pre_feedforward_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "attn_norm",
      "role": "NORM",
      "gguf": "blk.%d.attn_norm.weight"
    },
    {
      "match": "ffn_norm",
      "role": "NORM",
      "gguf": "blk.%d.ffn_norm.weight"
    },
    {
      "match": "kv_a_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_kv_a_norm.weight"
    },
    {
      "match": "q_a_layernorm",
      "role": "NORM",
      "gguf": "blk.%d.attn_q_a_norm.weight"
    },
    {
      "match": "embed_tokens",
      "role": "EMBEDDING",
      "gguf": "token_embd.weight"
    },
    {
      "match": "lm_head",
      "role": "OUTPUT",
      "gguf": "output.weight"
    },
    {
      "match": "recurrent.conv1d",
      "role": "SSM_CONV"
    },
    {
      "match": "recurrent.lin_proj",
      "role": "SSM_IN"
    },
    {
      "match": "recurrent.rnn",
      "role": "SSM_RNN"
    },
    {
      "match": "norm",
      "role": "NORM",
      "gguf": "output_norm.weight"
    }
  ],
  "quant": {
    "NORM": "f32",
    "EMBEDDING": "f16"
  },
  "structures": {
    "layer": {
      "type": "transformer_layer",
      "steps": [
        {
          "op": "attention",
          "prim": ""
        },
        {
          "op": "ffn",
          "prim": ""
        }
      ]
    },
    "norm": {
      "type": "rmsnorm"
    },
    "state": {
      "type": "griffin"
    }
  },
  "runtime": {
    "state": {
      "kind": "recurrent"
    }
  },
  "codecs": {
    "mlx_affine": "mlx_affine",
    "plain": "plain",
    "fp8_block": "fp8_block",
    "fp4_expert": "fp4_expert"
  },
  "quant_params": {
    "group": 32,
    "bits": 4
  },
  "weight_source": {
    "mlx_affine": {
      "dtype": "U32",
      "codec": "mlx_affine",
      "scale_suffix": ".scales",
      "bias_suffix": ".biases"
    },
    "plain_f16": {
      "dtype": "F16",
      "codec": "plain",
      "fmt": 1
    },
    "plain_bf16": {
      "dtype": "BF16",
      "codec": "plain",
      "fmt": 2
    },
    "plain_f32": {
      "dtype": "F32",
      "codec": "plain",
      "fmt": 0
    }
  },
  "convert_target": {
    "default": {
      "codec": "mlx_affine",
      "p0": 32,
      "p1": 4
    }
  }
}
